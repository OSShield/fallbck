# nginx reverse proxy example for fallbck-server.
# Agents use gRPC (HTTP/2) and browsers use HTTP/1.1 on the same public port; nginx
# needs a separate grpc_pass location selected by Content-Type.
map $http_content_type $fallbck_is_grpc {
    default 0;
    "~^application/grpc" 1;
}

upstream fallbck {
    server fallbck-server:8080;
}

server {
    listen 443 ssl;
    http2 on;
    server_name backup.example.com;

    ssl_certificate     /etc/ssl/certs/backup.example.com.crt;
    ssl_certificate_key /etc/ssl/private/backup.example.com.key;

    client_max_body_size 0;           # PBS chunk uploads

    location / {
        if ($fallbck_is_grpc) {
            grpc_pass grpc://fallbck;  # h2c to the backend
        }
        proxy_pass http://fallbck;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;       # > 70s agent long polls
        proxy_send_timeout 120s;
        proxy_request_buffering off;
    }

    grpc_read_timeout 120s;
    grpc_send_timeout 120s;
}
