# Environment overrides for fallbck-server (FALLBCK_* variables take precedence over
# /etc/fallbck/server.yaml). Keep secrets here rather than in the YAML, e.g.:
#FALLBCK_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
#FALLBCK_OIDC_CLIENT_SECRET=...
#FALLBCK_DB_URL=postgres://fallbck:password@localhost:5432/fallbck?sslmode=disable
