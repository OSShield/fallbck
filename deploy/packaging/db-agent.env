# Environment for fallbck-db-agent. Either enroll interactively:
#   fallbck-db-agent enroll --server https://backup.example.com --token <enrollment token>
# or let the service enroll itself on first start:
#FALLBCK_AGENT_SERVER_URL=https://backup.example.com
#FALLBCK_AGENT_ENROLLMENT_KEY=<enrollment token>
# Credential profiles for jobs that leave the password blank (alternatively
# db_backup.profiles in /var/lib/fallbck/db-agent/agent.yaml):
#FALLBCK_AGENT_DB_PROFILE_POSTGRES_USER=backup
#FALLBCK_AGENT_DB_PROFILE_POSTGRES_PASSWORD=secret
# Pin a client tool directory (e.g. a newer pg_dump than the one on PATH):
#FALLBCK_AGENT_DB_POSTGRES_BINDIR=/usr/lib/postgresql/17/bin
# Verbose logging for troubleshooting:
#DEBUG=true
