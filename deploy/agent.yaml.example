# fallbck-agent configuration (written by `fallbck-agent enroll`; edit rarely).
# The agent reaches everything — REST API, PBS proxy and Temporal gRPC — through server_url.
agent_id: "auto-generated-uuid"
hostname: "web-server-01"
server_url: "https://backup.example.com"
data_dir: "/var/lib/fallbck/agent"
task_queue: "fallbck-agent-auto-generated-uuid"
namespace: ""
auth_token: "eyJ..."                 # bearer token issued at enrollment (file must be 0600)
token_expires_at: 2027-08-25T00:00:00Z
# server_ca_cert_path: "/var/lib/fallbck/agent/server-ca.crt"   # private CA for server_url
# insecure_skip_verify: false
# log_level: info                    # debug|info|warn|error; DEBUG=true env wins; the web UI can raise it to debug live
# enrollment_key: ""                 # set (or FALLBCK_AGENT_ENROLLMENT_KEY) to self-enroll on first start
# docker_backup:                     # Docker host jobs (env FALLBCK_AGENT_DOCKER_*)
#   volume_access: auto              # auto | direct (read /var/lib/docker/volumes) | helper (throwaway containers)
#   helper_image: alpine:3.20        # image of the helper containers
#   socket: /var/run/docker.sock     # default: DOCKER_HOST (unix://) or /var/run/docker.sock

# Database jobs (the agent runs them when the vendor client tools are installed; it
# reports them as db_tools). This section is yours to edit and survives re-enrollment.
# db_backup:
#   spool_dir: /var/lib/fallbck/agent/spool        # dumps are staged here before upload
#   state_dir: /var/lib/fallbck/agent/state/db     # last binlog / WAL position per job
#   min_free_bytes: 1073741824                     # refuse to start a run below this free space
#   keep_failed_spool: false                       # keep the spool of failed runs for inspection
#   tools:
#     postgres_bindir: /usr/lib/postgresql/17/bin  # pin a pg_dump at least as new as the server
#     mysql_bindir: /usr/bin
#     mongo_bindir: /usr/local/bin
#   # Credential profiles used by jobs whose password is left blank in the UI. A job
#   # names its profile (default: the engine name); the profile may also supply user,
#   # host, port and TLS settings the job leaves blank. Readable by root only.
#   profiles:
#     postgres:
#       engine: postgres
#       user: backup
#       password_file: /etc/fallbck/pg-backup.pass   # or password: "..."
#       tls: { mode: verify-full, ca_file: /etc/ssl/certs/corp-ca.pem }
#     mysql:
#       engine: mysql
#       user: backup
#       password: "s3cret"
#     mssql:                                        # SQL Server: a SQL login; leave the job's user
#       engine: mssql                               # blank instead for Windows integrated authentication
#       user: fallbck_backup
#       password_file: /etc/fallbck/mssql-backup.pass
