#!/sbin/openrc-run
# FallBCK database backup agent

description="FallBCK database backup agent"
command="/usr/local/bin/fallbck-db-agent"
command_args="run --config ${FALLBCK_AGENT_DATA_DIR:-/var/lib/fallbck/db-agent}/agent.yaml"
command_user="fallbck:fallbck"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
directory="/var/lib/fallbck/db-agent"
output_log="/var/log/fallbck/db-agent.log"
error_log="/var/log/fallbck/db-agent.log"
retry="SIGTERM/60"

export FALLBCK_AGENT_DATA_DIR="${FALLBCK_AGENT_DATA_DIR:-/var/lib/fallbck/db-agent}"

depend() {
	need net
}

start_pre() {
	checkpath --directory --mode 0700 --owner fallbck:fallbck "${FALLBCK_AGENT_DATA_DIR}"
	checkpath --directory --mode 0750 --owner fallbck:fallbck /var/log/fallbck
	checkpath --file --mode 0640 --owner fallbck:fallbck /var/log/fallbck/db-agent.log
	# Enroll first, or set FALLBCK_AGENT_ENROLLMENT_KEY / FALLBCK_AGENT_SERVER_URL in /etc/fallbck/db-agent.env
	if [ -f /etc/fallbck/db-agent.env ]; then
		set -a
		. /etc/fallbck/db-agent.env
		set +a
	fi
}
