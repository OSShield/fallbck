http_port: 8080
http_bind: "0.0.0.0"
public_url: "http://localhost:8080"
jwt_secret: "super-secret-key-change-in-production-must-be-long"
data_dir: "/var/lib/fallbck/server"
ca_cert_path: "/var/lib/fallbck/server/certs/ca.crt"
ca_key_path: "/var/lib/fallbck/server/certs/ca.key"
proxy_port: 8443

database:
  url: "postgres://fallbck:fallbck_password@localhost:5432/fallbck?sslmode=disable"
  max_open_conns: 25
  max_idle_conns: 5
  auto_migrate: true

temporal:
  host_port: "localhost:7233"
  namespace: "default"
  enable_tls: false
  connect_timeout: 10s
