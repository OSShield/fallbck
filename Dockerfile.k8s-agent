# syntax=docker/dockerfile:1
# fallbck-k8s-agent: in-cluster Kubernetes backup agent (API resources + PVC data to
# PBS through the FallBCK server). The same image serves as the volume-upload worker
# (args: ["worker"]). Built by GoReleaser (dockers_v2) from the prebuilt
# $TARGETPLATFORM/fallbck-k8s-agent.

FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/fallbck-k8s-agent /usr/local/bin/fallbck-k8s-agent

# The agent runs unprivileged; worker pods set their own securityContext (root with
# only DAC_OVERRIDE by default, to read arbitrarily-owned PVC files).
RUN addgroup -S fallbck && adduser -S -G fallbck -u 10004 fallbck
USER fallbck

ENV FALLBCK_IN_CONTAINER=1
ENTRYPOINT ["/usr/local/bin/fallbck-k8s-agent"]
CMD ["run"]
