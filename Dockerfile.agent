# syntax=docker/dockerfile:1
# fallbck-agent: backup worker that talks to the FallBCK server (REST + Temporal gRPC via
# the server's gateway) through a single server URL. Two targets:
#   slim  (oci.fi/fallbck/agent:latest) filesystem, Proxmox VE and Docker host jobs
#   tools (oci.fi/fallbck/agent:tools)  slim plus the PostgreSQL, MariaDB and MongoDB client
#                                       tools, so the same agent runs database jobs

# ---- Build stage -------------------------------------------------------------
FROM golang:1-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

ARG FALLBCK_VERSION=0.1.0
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags="-s -w -X main.AgentVersion=${FALLBCK_VERSION}" \
      -o /bin/fallbck-agent ./cmd/fallbck-agent

# ---- mariadb-binlog ------------------------------------------------------------
# Alpine ships mariadb-binlog only inside the (large) mariadb server package; take the
# single binary from it so binary-log fetching works without the server.
FROM alpine:3.21 AS mariadb-tools
RUN apk add --no-cache mariadb

# ---- Runtime stage: slim -----------------------------------------------------
FROM alpine:3.21 AS slim

RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -S fallbck && adduser -S -G fallbck -u 10002 fallbck && \
    mkdir -p /var/lib/fallbck/agent /backup-data && \
    chown -R fallbck:fallbck /var/lib/fallbck /backup-data

COPY --from=builder /bin/fallbck-agent /usr/local/bin/fallbck-agent

USER fallbck

ENV FALLBCK_AGENT_DATA_DIR=/var/lib/fallbck/agent

VOLUME ["/var/lib/fallbck/agent", "/backup-data"]

ENTRYPOINT ["/usr/local/bin/fallbck-agent"]
CMD ["run"]

# ---- Runtime stage: tools ----------------------------------------------------
# Alpine 3.21 ships PostgreSQL 17 client tools (pg_dump must be at least as new as the
# server it dumps), MariaDB client tools and MongoDB Database Tools 100.x. The agent
# detects them and reports db_tools, which lets the server assign database jobs to it.
FROM slim AS tools

USER root
RUN apk add --no-cache postgresql17-client mariadb-client mongodb-tools
COPY --from=mariadb-tools /usr/bin/mariadb-binlog /usr/bin/mariadb-binlog
RUN ln -s mariadb-binlog /usr/bin/mysqlbinlog && mariadb-binlog --version
USER fallbck
